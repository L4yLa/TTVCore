<horizontal spacing='3' pad='2' horizontal-fit='PreferredSize' vertical-fit='PreferredSize' child-align='UpperCenter' child-expand-width='false' child-control-width='true'>
  <!-- child-control-height を true にしないと、一覧（LayoutElement で大きさを決める）の高さが 0 になる（TTVStreamersKit の QueueView と同じ） -->
  <!-- 一覧のスクロールバーは一覧の右端の外（約 4）に付くため、列の幅は一覧の幅 + 4。一覧は child-expand-width='false' で list-width のままにする -->
  <vertical pref-width='60' spacing='1' child-control-height='true' child-expand-height='false' child-expand-width='false' vertical-fit='PreferredSize'>
    <!-- text は LayoutElement を持たず pref-width が効かないため、列と同じ幅の horizontal で包んで中央に置く -->
    <horizontal pref-width='60' pref-height='7' child-align='MiddleCenter'>
      <text text='{{Notification tests|通知のテスト}}' font-size='5' align='Center' />
    </horizontal>
    <horizontal pref-width='60' pref-height='4' child-align='MiddleCenter'>
      <text text='{{Select one to send it once|選ぶと1件流します}}' font-size='3' align='Center' />
    </horizontal>
    <list id='notification-list' select-cell='notification-selected' visible-cells='8' list-width='56' show-scrollbar='true' />
  </vertical>
  <!-- slider-setting は右のスライダーを幅 52 で固定し、残りを項目名に使う（BSML の GenericSliderSettingTag）。75 なら項目名に 23 残る -->
  <vertical pref-width='75' spacing='2' child-control-height='true' child-expand-height='false' vertical-fit='PreferredSize'>
    <horizontal pref-width='75' pref-height='7' child-align='MiddleCenter'>
      <text text='{{Chat test|チャットのテスト}}' font-size='5' align='Center' />
    </horizontal>
    <horizontal pref-width='75' pref-height='4' child-align='MiddleCenter'>
      <text text='{{Random messages from 100 test messages|テスト用の100件からランダムに流します}}' font-size='3' align='Center' />
    </horizontal>
    <slider-setting text='{{Messages|流す数}}' value='chat-count' min='10' max='1000' increment='10' integer-only='true' apply-on-change='true' />
    <slider-setting text='{{Speed|速度}}' value='chat-speed' min='1' max='10' increment='1' integer-only='true' formatter='format-speed' apply-on-change='true' />
    <horizontal pref-width='75' pref-height='8' child-align='MiddleCenter'>
      <button text='~chat-button-text' on-click='chat-toggle' pref-width='40' pref-height='8' />
    </horizontal>
    <horizontal pref-width='75' pref-height='5' child-align='MiddleCenter'>
      <text text='~chat-status' font-size='3.5' align='Center' />
    </horizontal>
  </vertical>
</horizontal>
